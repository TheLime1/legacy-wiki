{
  "name": "legacy-wiki",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run build:canonical && npm run build:github && npm run build:cloudflare && node scripts/package-pages.mjs",
    "build:canonical": "cross-env ASTRO_TELEMETRY_DISABLED=1 LEGACY_WIKI_TARGET=canonical astro build",
    "build:github": "cross-env ASTRO_TELEMETRY_DISABLED=1 LEGACY_WIKI_TARGET=github astro build",
    "build:cloudflare": "cross-env ASTRO_TELEMETRY_DISABLED=1 LEGACY_WIKI_TARGET=cloudflare astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "smoke": "node scripts/smoke-site.mjs",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts/*.mjs tests/*.mjs && prettier --check .",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:html": "node scripts/validate-html.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "test": "node --test",
    "check": "npm run typecheck && npm run lint && npm run validate:content && npm test && npm run build && npm run validate:links && npm run validate:html && npm run smoke"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.6",
    "astro": "7.1.6",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "cross-env": "10.1.0",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}

---
import catalog from '../data/catalog.json';
import { componentText, gameText, localeCode, type WikiLocale } from '../data/localization';

interface Props {
  kind: 'classes' | 'abilities' | 'properties' | 'items';
  locale?: WikiLocale;
}

const { kind, locale = 'en' } = Astro.props;
const labels = componentText[locale];
const t = (value: string | number | null | undefined) => gameText(String(value ?? ''), locale);
const format = (value: number) =>
  value.toLocaleString(localeCode(locale), { maximumFractionDigits: 6 });
---

<div class="catalog-table">
  {
    kind === 'classes' && (
      <table>
        <caption>{labels.classCatalog}</caption>
        <thead>
          <tr>
            <>
              <th scope="col">{labels.class}</th>
              <th scope="col">{labels.group}</th>
              <th scope="col">{labels.baseXp}</th>
              <th scope="col">{labels.copperDay}</th>
              <th scope="col">{labels.unlock}</th>
            </>
          </tr>
        </thead>
        <tbody>
          {catalog.classes.map((entry) => (
            <tr>
              <td>
                <strong>{t(entry[1])}</strong>
              </td>
              <td>
                {t(
                  catalog.classCategories.find((category) => category.id === entry[2])?.name ?? '',
                )}
              </td>
              <td>{format(Number(entry[3]))}</td>
              <td>{format(Number(entry[4]))}</td>
              <td>{t(entry[5])}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
  {
    kind === 'abilities' && (
      <table>
        <caption>{labels.abilityCatalog}</caption>
        <thead>
          <tr>
            <>
              <th scope="col">{labels.ability}</th>
              <th scope="col">{labels.group}</th>
              <th scope="col">{labels.affects}</th>
              <th scope="col">{labels.formula}</th>
              <th scope="col">{labels.coefficient}</th>
              <th scope="col">{labels.unlock}</th>
            </>
          </tr>
        </thead>
        <tbody>
          {catalog.abilities.map((entry) => (
            <tr>
              <td>
                <strong>{t(entry[1])}</strong>
              </td>
              <td>
                {t(
                  catalog.abilityCategories.find((category) => category.id === entry[2])?.name ??
                    '',
                )}
              </td>
              <td>{t(entry[3])}</td>
              <td>{t(entry[4])}</td>
              <td>{entry[5] === null ? '—' : format(Number(entry[5]))}</td>
              <td>{t(entry[6])}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
  {
    kind === 'properties' && (
      <table>
        <caption>{labels.propertyCatalog}</caption>
        <thead>
          <tr>
            <>
              <th scope="col">{labels.property}</th>
              <th scope="col">{labels.expense}</th>
              <th scope="col">{labels.happiness}</th>
              <th scope="col">{labels.unlock}</th>
            </>
          </tr>
        </thead>
        <tbody>
          {catalog.properties.map((entry) => (
            <tr>
              <td>
                <strong>{t(entry[1])}</strong>
              </td>
              <td>{format(Number(entry[2]))}</td>
              <td>×{format(Number(entry[3]))}</td>
              <td>{t(entry[4])}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
  {
    kind === 'items' && (
      <table>
        <caption>{labels.possessionCatalog}</caption>
        <thead>
          <tr>
            <>
              <th scope="col">{labels.item}</th>
              <th scope="col">{labels.expense}</th>
              <th scope="col">{labels.effect}</th>
              <th scope="col">{labels.channel}</th>
              <th scope="col">{labels.unlock}</th>
            </>
          </tr>
        </thead>
        <tbody>
          {catalog.items.map((entry) => (
            <tr>
              <td>
                <strong>{t(entry[1])}</strong>
              </td>
              <td>{format(Number(entry[2]))}</td>
              <td>×{format(Number(entry[3]))}</td>
              <td>{t(entry[4])}</td>
              <td>{t(entry[5])}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</div>

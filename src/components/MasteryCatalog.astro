---
import mastery from '../data/mastery-items.json';
import { componentText, gameText, localeCode, type WikiLocale } from '../data/localization';

interface Props {
  locale?: WikiLocale;
}

const { locale = 'en' } = Astro.props;
const labels = componentText[locale];
const t = (value: string) => gameText(value, locale);
const numberLocale = localeCode(locale);
const base = import.meta.env.BASE_URL;
const formatPercent = (value: number) =>
  `${value.toLocaleString(numberLocale, { maximumFractionDigits: 2 })}%`;
const tierClass = (tier: string) => `mastery-${tier}`;
---

<div class="mastery-catalog">
  {
    mastery.categories.map((category) => {
      const items = mastery.items.filter((item) => item.category === category.id);
      return (
        <section
          class="mastery-wiki-category"
          style={`--mastery-category: ${category.color}`}
          aria-labelledby={`mastery-${category.id}`}
        >
          <h2 id={`mastery-${category.id}`}>{t(category.name)}</h2>
          <div class="mastery-wiki-grid">
            {items.map((item) => {
              const [author, slug] = item.icon.split('/');
              const secondaryScale = item.secondaryScale as 'related' | 'global';
              const secondaryValues = mastery.tiers.map((tier) => tier[secondaryScale]);
              return (
                <article class="mastery-wiki-card">
                  <header>
                    <span
                      class="mastery-wiki-icon"
                      style={`--mastery-icon: url("${base}mastery/${item.id}.png")`}
                      aria-hidden="true"
                    />
                    <div>
                      <p class="mastery-wiki-job">{t(item.job)}</p>
                      <h3>{t(item.name)}</h3>
                    </div>
                  </header>

                  <dl>
                    <div>
                      <dt>{labels.routeLevel}</dt>
                      <dd>P = {item.routeLevel.toLocaleString(numberLocale)}</dd>
                    </div>
                    <div>
                      <dt>{labels.secondary}</dt>
                      <dd>{t(item.secondary)}</dd>
                    </div>
                  </dl>

                  <div class="mastery-thresholds" aria-label={labels.thresholds}>
                    {mastery.tiers.map((tier, index) => (
                      <span class={tierClass(tier.id)}>
                        <strong>{t(tier.name)}</strong>{' '}
                        {item.thresholds[index].toLocaleString(numberLocale)}
                      </span>
                    ))}
                  </div>

                  <div class="mastery-effects">
                    <p>
                      <strong>{labels.ownXp}:</strong>{' '}
                      {mastery.tiers.map((tier) => formatPercent(tier.ownJobXp)).join(' / ')}
                    </p>
                    <p>
                      <strong>{t(item.secondary)}:</strong>{' '}
                      {secondaryValues.map((value) => formatPercent(value)).join(' / ')}
                    </p>
                  </div>

                  <a
                    class="mastery-attribution"
                    href={`https://game-icons.net/1x1/${author}/${slug}.html`}
                  >
                    {labels.iconBy} {author === 'lorc' ? 'Lorc' : 'Delapouite'} · CC BY 3.0
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      );
    })
  }
</div>

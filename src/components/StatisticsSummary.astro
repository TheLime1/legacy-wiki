---
import statistics from '../data/statistics.json';

const stats = statistics.packageStats;
const retrieved = new Date(statistics.retrievedAt).toLocaleString('en-GB', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'UTC',
});
---

<div class="card-grid">
  <div class="card"><strong>{stats.playersAllTime}</strong><span>all-time players</span></div>
  <div class="card"><strong>{stats.sessionsAllTime}</strong><span>all-time sessions</span></div>
  <div class="card"><strong>{stats.totalPlaytimeHours}h</strong><span>total playtime</span></div>
  <div class="card">
    <strong>{stats.averagePerPlayerMinutes}m</strong><span>average per player</span>
  </div>
</div>
<p><small>Snapshot retrieved {retrieved}. Statistics may be stale between refreshes.</small></p>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    margin-block: 1rem;
  }
  .card {
    display: grid;
    gap: 0.2rem;
    border: 1px solid rgb(240 208 0 / 24%);
    border-radius: 0.7rem;
    padding: 1rem;
    background: rgb(240 208 0 / 5%);
  }
  strong {
    color: var(--sl-color-accent-high);
    font-size: 1.5rem;
  }
  span {
    color: var(--sl-color-gray-2);
  }
</style>
